# Required API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Optional API Keys
STABILITY_API_KEY=sk-...

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Redis (optional, for production state management)
REDIS_URL=redis://localhost:6379/0

# ── Google OAuth (optional — leave blank to disable the auth gate in dev) ──────
# Create credentials at: https://console.cloud.google.com/apis/credentials
#   Application type : Web application
#   Authorized redirect URIs:
#     - http://localhost:8501/          (local dev)
#     - https://<your-cloud-run-url>/   (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match one of the Authorized redirect URIs above
OAUTH_REDIRECT_URI=http://localhost:8501/

# ── Squarespace Blog Publishing (optional — leave blank to hide the button) ──
# Generate an API key at: Squarespace Admin → Settings → Developer → API Keys
# Find the blog collection ID in the page settings URL when editing the blog page
SQUARESPACE_API_KEY=
SQUARESPACE_SITE_URL=https://www.vijaybhore.dev
SQUARESPACE_BLOG_COLLECTION_ID=5c7a3571652dea887e9e8bbf

# ── Ghost Blog Publishing (optional — leave blank to hide the button) ──────
# In Ghost Admin: Settings → Integrations → Add Custom Integration
# Copy the Admin API Key (format: id:secret)
GHOST_ADMIN_API_KEY=
GHOST_API_URL=https://the-algorithmic-lens.ghost.io
